  },
  {
   "fieldname": "refund_penalties",
   "fieldtype": "Select",
   "label": "Penalties Paid in Refund Base",
   "options": "Excluded\nIncluded",
   "default": "Excluded",
   "description": ""
  },
  {
   "fieldname": "section_title",
   "fieldtype": "Section Break",
   "label": "Title Deadline — stored only, not applied by the system",
   "collapsible": 1,
   "description": "Recorded contract terms only; not calculated or posted by the system."
  },
  {
   "fieldname": "title_deadline_days",
   "fieldtype": "Int",
   "label": "Title Deadline (days after final payment)",
   "description": "0 = not set; required unless the profile is on legal hold."
  },
  {
   "fieldname": "title_deadline_note",
   "fieldtype": "Small Text",
   "label": "Title Deadline Note"
  },
  {
   "fieldname": "column_break_title",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "title_penalty_type",
   "fieldtype": "Select",
   "label": "Sidra Title Delay Penalty",
   "options": "None\nPer Day\nPer Month",
