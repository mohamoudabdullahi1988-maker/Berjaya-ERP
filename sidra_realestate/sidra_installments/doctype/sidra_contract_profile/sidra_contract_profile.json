  {
   "fieldname": "title_refund_compensation_pct",
   "fieldtype": "Percent",
   "label": "Refund Compensation %",
   "depends_on": "title_refund_after_days"
  },
  {
   "fieldname": "title_refund_from",
   "fieldtype": "Select",
   "label": "Refund Right Days Counted From",
   "options": "Pending Decision\nFinal Payment\nTitle Deadline",
   "default": "Pending Decision",
   "depends_on": "title_refund_after_days",
   "description": ""
  },
  {
   "fieldname": "title_refund_compensation_base",
   "fieldtype": "Select",
   "label": "Compensation % Applies To",
   "options": "Pending Decision\nAmount Paid\nAgreed Price",
   "default": "Pending Decision",
   "depends_on": "title_refund_after_days",
