  },
  {
   "fieldname": "title_deadline_note",
   "fieldtype": "Small Text",
   "label": "Title Deadline Note"
  },
  {
   "fieldname": "column_break_title",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "title_penalty_type",
   "fieldtype": "Select",
   "label": "Sidra Title Delay Penalty",
   "options": "None\nPer Day\nPer Month",
   "default": "None"
  },
  {
   "fieldname": "title_penalty_amount",
   "fieldtype": "Currency",
   "label": "Title Delay Amount",
   "options": "USD",
   "depends_on": "eval:doc.title_penalty_type!='None'"
  },
  {
   "fieldname": "title_refund_after_days",
   "fieldtype": "Int",
   "label": "Buyer Refund Right After (days)",
   "description": "0 = off"
  },
  {
   "fieldname": "title_refund_compensation_pct",
   "fieldtype": "Percent",
