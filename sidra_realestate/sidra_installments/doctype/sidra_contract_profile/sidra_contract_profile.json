   "description": "SRS v2.0 §1.6: no destination until Legal / Sharia / Finance approve."
  },
  {
   "fieldname": "section_default",
   "fieldtype": "Section Break",
   "label": "Default and Refund — stored only, not applied by the system",
   "collapsible": 1,
   "description": "Recorded contract terms only; not calculated or posted by the system."
  },
  {
   "fieldname": "default_trigger_missed",
   "fieldtype": "Int",
   "label": "Consecutive Missed Installments for Review",
   "description": "0 = off"
  },
  {
   "fieldname": "column_break_default",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "refund_retention_type",
   "fieldtype": "Select",
   "label": "Refund Retention",
   "options": "None\nOne Installment\nFixed\nPercent",
   "default": "None"
  },
  {
   "fieldname": "refund_retention_value",
   "fieldtype": "Float",
   "label": "Retention Amount or %",
   "depends_on": "eval:in_list(['Fixed','Percent'], doc.refund_retention_type)"
  },
  {
   "fieldname": "missed_after_days",
   "fieldtype": "Int",
   "label": "Days After Due Date Before an Installment Counts as Missed",
   "default": "0",
   "description": "0 = missed from the day after the due date"
  },
  {
   "fieldname": "refund_installment_basis",
   "fieldtype": "Select",
