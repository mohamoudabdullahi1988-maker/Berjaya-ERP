   "fieldtype": "Data",
   "label": "Profile Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "is_default",
   "fieldtype": "Check",
   "label": "Default Profile",
   "in_list_view": 1
  },
  {
   "fieldname": "active",
   "fieldtype": "Check",
   "label": "Active",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_hold",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "legal_hold",
   "fieldtype": "Check",
   "label": "Legal Hold",
   "in_list_view": 1,
   "description": "Contracts on a profile under legal hold can be drafted but not submitted."
  },
  {
   "fieldname": "legal_hold_reason",
   "fieldtype": "Small Text",
   "label": "Legal Hold Reason",
   "depends_on": "legal_hold",
   "mandatory_depends_on": "legal_hold"
  },
  {
   "fieldname": "section_plan",
   "fieldtype": "Section Break",
   "label": "Payment Plan"
  },
  {
   "fieldname": "installments",
   "fieldtype": "Int",
   "label": "Number of Installments",
   "reqd": 1
  },
  {
   "fieldname": "due_day",
   "fieldtype": "Int",
   "label": "Due Day of Month",
   "reqd": 1,
   "default": "5",
   "description": "1 to 28"
  },
  {
   "fieldname": "grace_months",
   "fieldtype": "Int",
   "label": "Grace Months Before First Installment",
   "default": "0"
  },
  {
   "fieldname": "column_break_plan",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "down_payment_type",
   "fieldtype": "Select",
   "label": "Down Payment",
   "options": "None\nFixed\nPercent",
   "default": "None"
  },
  {
   "fieldname": "down_payment_value",
   "fieldtype": "Float",
   "label": "Down Payment Amount or %",
   "depends_on": "eval:doc.down_payment_type!='None'"
  },
  {
   "fieldname": "markup_rate",
   "fieldtype": "Percent",
   "label": "Annual Markup Rate",
   "default": "0",
   "description": "Agreed-price sales use no additional markup."
  },
  {
   "fieldname": "early_payment",
   "fieldtype": "Select",
   "label": "Early Payment",
   "options": "Reduce Last Installments",
   "default": "Reduce Last Installments"
  },
  {
   "fieldname": "section_penalty",
   "fieldtype": "Section Break",
   "label": "Buyer Late Penalty — stored only, not applied by the system",
   "collapsible": 1,
   "description": "Recorded contract terms only; not calculated or posted by the system."
  },
  {
   "fieldname": "penalty_type",
   "fieldtype": "Select",
   "label": "Penalty Type",
   "options": "None\nPer Day Capped\nFixed After Notice",
   "default": "None"
  },
  {
   "fieldname": "penalty_per_day",
   "fieldtype": "Currency",
   "label": "Amount per Day",
   "depends_on": "eval:doc.penalty_type=='Per Day Capped'"
  },
  {
   "fieldname": "penalty_monthly_cap",
   "fieldtype": "Currency",
   "label": "Monthly Cap",
   "depends_on": "eval:doc.penalty_type=='Per Day Capped'"
  },
  {
   "fieldname": "column_break_penalty",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "penalty_fixed_amount",
   "fieldtype": "Currency",
   "label": "Fixed Amount",
   "depends_on": "eval:doc.penalty_type=='Fixed After Notice'"
  },
  {
   "fieldname": "notice_days",
   "fieldtype": "Int",
   "label": "Written Notice Days",
   "depends_on": "eval:doc.penalty_type=='Fixed After Notice'"
  },
  {
   "fieldname": "penalty_grace_days",
   "fieldtype": "Int",
   "label": "Days After Due Date Before Per-Day Penalty Starts",
   "default": "0",
   "depends_on": "eval:doc.penalty_type=='Per Day Capped'",
   "description": "Waiting period. 0 = from the day after the due date"
  },
  {
   "fieldname": "penalty_cap_basis",
   "fieldtype": "Select",
   "label": "Cap Applies",
   "options": "Per Installment\nPer Installment, Each 30 Days Late\nPer Calendar Month",
   "default": "Per Installment",
   "depends_on": "eval:doc.penalty_type=='Per Day Capped'",
   "description": ""
  },
  {
   "fieldname": "notice_last_day",
   "fieldtype": "Select",
   "label": "Payment on the Last Notice Day",
   "options": "Counts as Late\nCounts as On Time",
   "default": "Counts as Late",
   "depends_on": "eval:doc.penalty_type=='Fixed After Notice'",
   "description": ""
  },
  {
   "fieldname": "receipt_order",
   "fieldtype": "Select",
   "label": "Receipt Pays First",
   "options": "Installments\nPenalties",
   "default": "Installments",
   "description": ""
  },
  {
   "fieldname": "extra_payment_allocation",
   "fieldtype": "Select",
   "label": "Payment Beyond What Is Due",
   "options": "Cashier Chooses\nOldest First\nReduce Last Installments",
   "default": "Cashier Chooses",
   "description": ": Oldest First = advance payment (AT-10); Reduce Last Installments = early payment (AT-13)"
  },
  {
   "fieldname": "penalty_destination",
   "fieldtype": "Select",
   "label": "Penalty Goes To",
   "options": "Pending Policy Sign-off",
   "default": "Pending Policy Sign-off",
