   "label": "Fixed Amount",
   "options": "USD",
   "depends_on": "eval:doc.penalty_type=='Fixed After Notice'"
  },
  {
   "fieldname": "notice_days",
   "fieldtype": "Int",
   "label": "Written Notice Days",
   "depends_on": "eval:doc.penalty_type=='Fixed After Notice'"
  },
  {
   "fieldname": "penalty_destination",
   "fieldtype": "Select",
   "label": "Penalty Goes To",
   "options": "Pending Policy Sign-off",
   "default": "Pending Policy Sign-off",
   "read_only": 1,
   "description": "SRS v2.0 §1.6: no destination until Legal / Sharia / Finance approve."
  },
  {
   "fieldname": "section_default",
   "fieldtype": "Section Break",
   "label": "Default and Refund (INS-16) — stored only, not applied in P0",
   "collapsible": 1
  },
  {
   "fieldname": "default_trigger_missed",
   "fieldtype": "Int",
   "label": "Consecutive Missed Installments for Review",
